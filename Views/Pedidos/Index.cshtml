@model IEnumerable<RubiaDivina.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<div class="container py-5">
    <div class="profile-header mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 font-weight-light">@ViewData["Title"]</h1>
            <a asp-action="Create" class="btn btn-primary insta-btn">
                <i class="fas fa-plus"></i> Nuevo Pedido
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col mb-4">
                <div class="card insta-card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="insta-title mb-1">@item.Cliente.Nombre @item.Cliente.Apellido</h5>
                                <small class="text-muted">@item.Producto.Nombre</small>
                            </div>
                            <span class="badge @(item.Pagado ? "insta-paid" : "insta-pending")">
                                @(item.Pagado ? "Pagado" : "Pendiente")
                            </span>
                        </div>
                        <div class="insta-order-details">
                            <div class="insta-detail-item">
                                <i class="fas fa-dollar-sign insta-detail-icon"></i>
                                <span>@string.Format(new System.Globalization.CultureInfo("es-CO"), "{0:C}", item.ValorTotal)</span>
                            </div>
                            <div class="insta-detail-item">
                                <i class="fas fa-calendar-day insta-detail-icon"></i>
                                <span>@item.FechaSolicitud.ToString("dd MMM yyyy")</span>
                            </div>
                            @if (item.Pagado)
                            {
                                <div class="insta-detail-item">
                                    <i class="fas fa-check-circle insta-detail-icon"></i>
                                    <span>@item.FechaPago?.ToString("dd MMM yyyy")</span>
                                </div>
                            }
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm insta-edit-btn">
                                    <i class="fas fa-edit">Editar</i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm insta-details-btn">
                                    <i class="fas fa-info-circle">Info</i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm insta-delete-btn">
                                    <i class="fas fa-trash-alt">Borrar</i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>