@model RubiaDivina.Models.Factura

@{
    ViewData["Title"] = "Eliminar";
}

<div class="container insta-container py-5">
    <div class="insta-delete-card">
        <div class="insta-delete-header mb-4">
            <h1 class="insta-main-title text-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>Eliminar Factura
            </h1>
            <p class="insta-subtitle">¿Estás seguro de eliminar esta factura permanentemente?</p>
            <hr class="insta-hr">
        </div>

        <div class="insta-delete-details">
            <div class="insta-detail-item">
                <div class="insta-detail-label">
                    <i class="fas fa-list-ol me-2"></i>Pedido asociado:
                </div>
                <div class="insta-detail-value">@Model.Pedido.Id</div>
            </div>

            <div class="insta-detail-item">
                <div class="insta-detail-label">
                    <i class="fas fa-calendar-alt me-2"></i>Fecha de Factura:
                </div>
                <div class="insta-detail-value">@Model.FechaFactura?.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="insta-detail-item">
                <div class="insta-detail-label">
                    <i class="fas fa-envelope me-2"></i>Enviar por Email:
                </div>
                <div class="insta-detail-value">
                    @if (Model.EnviarEmail)
                    {
                        <i class="fas fa-check-circle text-success"></i> <span>Sí</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-danger"></i> <span>No</span>
                    }
                </div>
            </div>
        </div>

        <form asp-action="Delete" class="mt-5">
            <input type="hidden" asp-for="Id" />
            <div class="insta-delete-actions">
                <button type="submit" class="insta-delete-btn">
                    <i class="fas fa-trash-alt me-2"></i>Confirmar Eliminación
                </button>
                <a asp-action="Index" class="insta-cancel-link">
                    <i class="fas fa-arrow-left me-2"></i>Volver al Listado
                </a>
            </div>
        </form>
    </div>
</div>
