@model RubiaDivina.Models.Factura

@{
    ViewData["Title"] = "Detalles";
}

<div class="container insta-container py-5">
    <div class="insta-details-card">
        <div class="insta-details-header mb-4">
            <h1 class="insta-main-title">
                <i class="fas fa-file-invoice me-2"></i>Factura #@Model.Id
            </h1>
            <p class="insta-subtitle">Detalles completos de la factura</p>
            <hr class="insta-hr">
        </div>

        <div class="insta-details-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-list-ol me-2"></i>Pedido asociado:
                        </div>
                        <div class="insta-detail-value">@Model.Pedido.Id</div>
                    </div>

                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-calendar-alt me-2"></i>Fecha de Factura:
                        </div>
                        <div class="insta-detail-value">@Model.FechaFactura?.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-envelope me-2"></i>Enviar por Email:
                        </div>
                        <div class="insta-detail-value">
                            @if (Model.EnviarEmail)
                            {
                                <i class="fas fa-check-circle text-success"></i>

                                <span>Sí</span>
                            }
                            else
                            {
                                <i class="fas fa-times-circle text-danger"></i>

                                <span>No</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="insta-details-actions mt-5">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="insta-edit-btn">
                <i class="fas fa-edit me-2"></i>Editar Factura
            </a>
            <a asp-action="Index" class="insta-cancel-link">
                <i class="fas fa-arrow-left me-2"></i>Volver al Listado
            </a>
        </div>
    </div>
</div>
