@model RubiaDivina.Models.Factura

@{
    ViewData["Title"] = "Editar";
}

<div class="container insta-container py-5">
    <div class="insta-form-card">
        <div class="insta-form-header mb-4">
            <h1 class="insta-main-title">
                <i class="fas fa-file-invoice me-2"></i>Editar Factura
            </h1>
            <p class="insta-subtitle">Modifica los detalles de la factura</p>
            <hr class="insta-hr">
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <form asp-action="Edit" class="insta-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="insta-form-group">
                        <label asp-for="PedidoId" class="insta-label">
                            <i class="fas fa-list-ol me-2"></i>Pedido
                        </label>
                        <select asp-for="PedidoId" class="insta-input" asp-items="ViewBag.PedidoId">
                            <option value="">Seleccione un pedido</option>
                        </select>
                        <span asp-validation-for="PedidoId" class="insta-validation"></span>
                    </div>

                    <div class="insta-form-group">
                        <label asp-for="FechaFactura" class="insta-label">
                            <i class="fas fa-calendar-alt me-2"></i>Fecha de Factura
                        </label>
                        <input asp-for="FechaFactura" class="insta-input" type="datetime-local">
                        <span asp-validation-for="FechaFactura" class="insta-validation"></span>
                    </div>

                    <div class="insta-form-group insta-checkbox-group">
                        <div class="form-check">
                            <input class="form-check-input insta-check-input" type="checkbox" asp-for="EnviarEmail">
                            <label class="form-check-label insta-label" asp-for="EnviarEmail">
                                <i class="fas fa-envelope me-2"></i>Enviar por Email
                            </label>
                        </div>
                        <span asp-validation-for="EnviarEmail" class="insta-validation"></span>
                    </div>

                    <div class="insta-form-footer mt-5">
                        <button type="submit" class="insta-submit-btn insta-update-btn">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="Index" class="insta-cancel-link">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
