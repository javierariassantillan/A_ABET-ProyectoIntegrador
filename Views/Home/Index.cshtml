@{
    ViewData["Title"] = "Home Page";
}

<body>
    <main>
        <section class="hero">
            <div class="container">
                <h1>Más que café y cerveza, una experiencia</h1>
                <p>Disfruta momentos únicos en Rubia Divina</p>
                <p>Conócenos <a href="https://www.instagram.com/rubiadivinaec/" target="_blank">Aquí</a>.</p>
            </div>
        </section>
        <div id="RubiaDivina" class="carousel slide mb-5" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Cafe.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Cafe">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Cerveza.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Cerveza">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Frase1.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Frase1">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Jueves.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Jueves">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Promo1.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Promo1">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_PromoSabado.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_PromoSabado">
                </div>
                <div class="carousel-item">
                    <img src="~/images/RubiaDivinaCoffee&Beer_Frase2.jpg" class="d-block" alt="RubiaDivinaCoffee&Beer_Frase2">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#RubiaDivina" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#RubiaDivina" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </main>
</body>