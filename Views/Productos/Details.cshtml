@model RubiaDivina.Models.Producto

@{
    ViewData["Title"] = "Details";
}

<div class="container insta-container py-5">
    <div class="insta-details-card">
        <div class="insta-details-header mb-4">
            <h1 class="insta-main-title">
                <i class="fas fa-info-circle me-2"></i>Detalles del Producto
            </h1>
            <p class="insta-subtitle">Información completa del producto</p>
            <hr class="insta-hr">
        </div>

        <div class="insta-details-body">
            <div class="row">
                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-tag me-2"></i>Nombre:
                        </div>
                        <div class="insta-detail-value">@Model.Nombre</div>
                    </div>

                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-dollar-sign me-2"></i>Precio:
                        </div>
                        <div class="insta-detail-value">@Model.Precio.ToString("C")</div>
                    </div>

                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-boxes me-2"></i>Stock:
                        </div>
                        <div class="insta-detail-value">@Model.Stock unidades disponibles</div>
                    </div>

                    <div class="insta-detail-item">
                        <div class="insta-detail-label">
                            <i class="fas fa-list-alt me-2"></i>Categoría:
                        </div>
                        <div class="insta-detail-value">@Model.Categoria.Nombre</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="insta-details-actions mt-5">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="insta-edit-btn">
                <i class="fas fa-edit me-2"></i>Editar
            </a>
            <a asp-action="Index" class="insta-cancel-link">
                <i class="fas fa-arrow-left me-2"></i>Volver al Listado
            </a>
        </div>
    </div>
</div>